# Railway environment variables for @nebula/api
# Copy values from your local .env into Railway → Service → Variables
# Railway injects PORT automatically — do not set PORT manually; railway-start.sh maps it to API_PORT.

# --- Required (startup fails without these) ---
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# --- Required for production CORS / auth redirects ---
WEB_URL=https://dev.ugazon.com
NEXT_PUBLIC_SITE_URL=https://dev.ugazon.com
SUPABASE_AUTH_REDIRECT_URL=https://dev.ugazon.com/auth/callback

# --- LLM (set keys for your LLM_PROVIDER) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- E2B Preview ---
E2B_API_KEY=
E2B_PREVIEW_TEMPLATE=nebula-nextjs-prisma

# --- Optional (have defaults in env.ts) ---
API_HOST=0.0.0.0
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_AUTH_GOOGLE_ENABLED=false
SUPABASE_AUTH_GITHUB_ENABLED=false
PREVIEW_TTL_MS=7200000
PREVIEW_SANDBOX_TIMEOUT_MS=900000
PREVIEW_RECONCILE_INTERVAL_MS=60000
PREVIEW_MAX_PER_USER=2
PREVIEW_COST_USD_PER_HOUR=0.1
ADMIN_EMAILS=
GITHUB_TOKEN_ENCRYPTION_KEY=
