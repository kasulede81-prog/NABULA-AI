# Web app — copy from repo root `.env.example` for full list.
# Optional analytics: set keys to enable PostHog in the browser.

# Local dev: Next.js rewrites /api → API_INTERNAL_URL
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://127.0.0.1:3001/v1

# Vercel + Railway split deploy (web on Vercel, API on Railway):
# Option A (recommended): browser calls Railway directly (set WEB_URL=https://dev.ugazon.com on API for CORS)
# NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.up.railway.app/v1
# Option B: keep /api proxy — set API_PUBLIC_URL to Railway PUBLIC url (NOT *.railway.internal)
# NEXT_PUBLIC_API_URL=/api
# API_PUBLIC_URL=https://YOUR-SERVICE.up.railway.app/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

NEXT_PUBLIC_UGAZON_DEPLOY_IP=185.158.133.1
NEXT_PUBLIC_UGAZON_DEPLOY_DOMAIN=ugazon.dev

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
