# Vercel environment variables for @nebula/web (dev.ugazon.com)
# Settings → Environment Variables → Production + Preview

# --- Required: point the browser (or /api rewrite) at the Railway API ---
# Copy the public URL from Railway → API service → Settings → Networking → Public domain
NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.up.railway.app/v1

# --- Alternative: same-origin /api proxy (only if you prefer not to expose API URL) ---
# NEXT_PUBLIC_API_URL=/api
# API_PUBLIC_URL=https://YOUR-SERVICE.up.railway.app/v1

# --- Site URLs (OAuth redirects, links) ---
NEXT_PUBLIC_SITE_URL=https://dev.ugazon.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
