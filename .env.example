# =============================================================================
# Nebula / Ugazon — environment setup
# Copy to `.env` at repo root. Optional APIs: leave blank to disable features.
# Restart API after changes. See Settings → Integrations for live status.
# =============================================================================

# --- Database (required) ---
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# --- Supabase (required for DB; also used for OAuth + optional file storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
SUPABASE_STORAGE_BUCKET=uploads
# Enable in Supabase Dashboard → Auth → Providers, then set true:
SUPABASE_AUTH_GOOGLE_ENABLED=false
SUPABASE_AUTH_GITHUB_ENABLED=false

# --- Auth (required) ---
JWT_SECRET=change-me-to-a-random-32-char-string-minimum

# --- App URLs ---
API_PORT=3001
API_HOST=0.0.0.0
WEB_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001/v1
NEXT_PUBLIC_API_URL=/api

# --- LLM providers (set at least one; LLM_PROVIDER picks default) ---
# Anthropic/OpenAI/Gemini also enable image attachments in chat (vision).
# All AI editor features (Tab, Fix with AI, terminal AI, Cmd+K) use these keys.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Live preview (optional — Preview tab disabled without key) ---
E2B_API_KEY=
E2B_PREVIEW_TEMPLATE=nebula-nextjs-prisma
AUTO_PREVIEW_ENABLED=true
PREVIEW_TTL_MS=7200000
PREVIEW_SANDBOX_TIMEOUT_MS=900000
PREVIEW_RECONCILE_INTERVAL_MS=60000
PREVIEW_MAX_PER_USER=2
PREVIEW_COST_USD_PER_HOUR=0.1

# --- GitHub export (optional — PAT or OAuth for repo sync/PR) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Deployments (optional — mock deploy when tokens unset) ---
VERCEL_TOKEN=
NETLIFY_TOKEN=
UGAZON_DEPLOY_DOMAIN=ugazon.dev
UGAZON_DEPLOY_IP=185.158.133.1
NEXT_PUBLIC_UGAZON_DEPLOY_IP=185.158.133.1
NEXT_PUBLIC_UGAZON_DEPLOY_DOMAIN=ugazon.dev

# --- Stripe billing (optional — manual upgrades when unset) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Observability (optional) ---
SENTRY_DSN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nebula <onboarding@resend.dev>
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Infrastructure (optional) ---
REDIS_URL=
FILE_STORAGE_BACKEND=postgres

# --- AI agents & editor (use the configured LLM provider) ---
REVIEWER_AGENT_ENABLED=false
# Bugbot: auto-reviews proposed changesets for bugs before you apply them
BUGBOT_ENABLED=false
# Cursor-Tab-style ghost-text completions in the code editor
TAB_AUTOCOMPLETE_ENABLED=true
# @web chat mentions — web search via Tavily (https://tavily.com, free tier)
TAVILY_API_KEY=

# --- Rate limits ---
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_PREVIEW_PER_MIN=10
RATE_LIMIT_GITHUB_PER_MIN=5
RATE_LIMIT_API_PER_MIN=120

# --- Admin ---
ADMIN_EMAILS=admin@example.com

# Local PostgreSQL fallback:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ugazon_dev
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ugazon_dev
