# =============================================================================
# Supabase — single source of truth (copy to .env and packages/database/.env)
# Project: https://supabase.com/dashboard → Settings → API / Database
# Production domain: https://dev.ugazon.com
# =============================================================================

# Prisma — pooled connection (port 6543, transaction mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Prisma migrations — direct/session connection (port 5432)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co

# Supabase anon key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role — server only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site URL for auth redirects and CORS
NEXT_PUBLIC_SITE_URL=https://dev.ugazon.com

# OAuth callback — add this URL in Supabase → Authentication → URL Configuration
SUPABASE_AUTH_REDIRECT_URL=https://dev.ugazon.com/auth/callback

# Storage bucket for uploads (create in Supabase → Storage)
SUPABASE_STORAGE_BUCKET=uploads

# Future OAuth providers (enable in Supabase dashboard, then set to true)
SUPABASE_AUTH_GOOGLE_ENABLED=false
SUPABASE_AUTH_GITHUB_ENABLED=false

# Local PostgreSQL fallback (uncomment instead of Supabase for offline dev):
# DATABASE_URL=postgresql://nebula:nebula_dev@localhost:5432/nebula_ai?client_encoding=UTF8
# DIRECT_URL=postgresql://nebula:nebula_dev@localhost:5432/nebula_ai?client_encoding=UTF8

# =============================================================================
# Auth (min 32 characters) — Nebula session JWT (until Supabase Auth migration)
# =============================================================================
JWT_SECRET=change-me-to-a-random-32-char-string-min

# =============================================================================
# API
# =============================================================================
API_PORT=3001
API_HOST=0.0.0.0
WEB_URL=https://dev.ugazon.com

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=https://dev.ugazon.com/api/v1

# =============================================================================
# LLM provider: anthropic | deepseek
# =============================================================================
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# =============================================================================
# E2B Preview
# =============================================================================
E2B_API_KEY=e2b_your_api_key_here
E2B_PREVIEW_TEMPLATE=nebula-nextjs-prisma
PREVIEW_TTL_MS=7200000
PREVIEW_SANDBOX_TIMEOUT_MS=900000
PREVIEW_RECONCILE_INTERVAL_MS=60000
PREVIEW_MAX_PER_USER=2
PREVIEW_COST_USD_PER_HOUR=0.1

# =============================================================================
# GitHub Export — PAT encryption (optional; defaults to JWT_SECRET derivative)
# =============================================================================
GITHUB_TOKEN_ENCRYPTION_KEY=

# =============================================================================
# Admin analytics (comma-separated emails)
# =============================================================================
ADMIN_EMAILS=admin@example.com
