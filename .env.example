# Database — local PostgreSQL (use same URL for both when not on Supabase)
DATABASE_URL=postgresql://nebula:nebula_dev@localhost:5432/nebula_ai?client_encoding=UTF8
DIRECT_URL=postgresql://nebula:nebula_dev@localhost:5432/nebula_ai?client_encoding=UTF8

# Supabase production (password with @ must be URL-encoded as %40):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres
# Prisma CLI also reads packages/database/.env (copy same two lines there)

# Auth (min 32 characters)
JWT_SECRET=change-me-to-a-random-32-char-string-min

# API
API_PORT=3001
API_HOST=0.0.0.0
WEB_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# LLM provider: anthropic | deepseek
LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# E2B Preview (Phase 3)
E2B_API_KEY=e2b_your_api_key_here
E2B_PREVIEW_TEMPLATE=nebula-nextjs-prisma
PREVIEW_TTL_MS=7200000
PREVIEW_SANDBOX_TIMEOUT_MS=900000
PREVIEW_RECONCILE_INTERVAL_MS=60000
PREVIEW_MAX_PER_USER=2
PREVIEW_COST_USD_PER_HOUR=0.1

# GitHub Export — PAT encryption (optional; defaults to JWT_SECRET derivative)
GITHUB_TOKEN_ENCRYPTION_KEY=

# Admin analytics (comma-separated emails)
ADMIN_EMAILS=admin@example.com
