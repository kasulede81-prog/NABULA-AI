# =============================================================================
# Ugazon dev — environment setup
# Copy to `.env` (repo root) and `packages/database/.env` for Prisma CLI
# Production: https://dev.ugazon.com
# =============================================================================

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=https://dev.ugazon.com
SUPABASE_AUTH_REDIRECT_URL=https://dev.ugazon.com/auth/callback
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_AUTH_GOOGLE_ENABLED=false
SUPABASE_AUTH_GITHUB_ENABLED=false

# --- Auth (Ugazon session JWT, min 32 chars) ---
JWT_SECRET=change-me-to-a-random-32-char-string-min

# --- App URLs ---
API_PORT=3001
API_HOST=0.0.0.0
WEB_URL=https://dev.ugazon.com
NEXT_PUBLIC_API_URL=https://dev.ugazon.com/api/v1

# --- LLM (required for AI chat + builds) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- Live preview (required for Preview tab) ---
E2B_API_KEY=e2b_your_api_key_here
E2B_PREVIEW_TEMPLATE=nebula-nextjs-prisma
PREVIEW_TTL_MS=7200000
PREVIEW_SANDBOX_TIMEOUT_MS=900000
PREVIEW_RECONCILE_INTERVAL_MS=60000
PREVIEW_MAX_PER_USER=2
PREVIEW_COST_USD_PER_HOUR=0.1

# --- GitHub export (required for GitHub panel) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Deployments (optional — mock works without these) ---
# Mock deploy runs by default. Set tokens for real provider deploys:
VERCEL_TOKEN=
NETLIFY_TOKEN=
UGAZON_DEPLOY_DOMAIN=ugazon.dev
UGAZON_DEPLOY_IP=185.158.133.1

# --- Custom domains UI (shown in Domains tab DNS instructions) ---
NEXT_PUBLIC_UGAZON_DEPLOY_IP=185.158.133.1
NEXT_PUBLIC_UGAZON_DEPLOY_DOMAIN=ugazon.dev

# --- Rate limits ---
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_PREVIEW_PER_MIN=10
RATE_LIMIT_GITHUB_PER_MIN=5

# --- Admin ---
ADMIN_EMAILS=admin@example.com

# Local PostgreSQL fallback:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ugazon_dev
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ugazon_dev
