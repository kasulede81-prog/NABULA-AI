generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  draft
  clarifying
  building
  ready
  failed
}

enum MessageRole {
  user
  assistant
  system
}

enum AgentType {
  clarifier
  builder
}

enum AgentRunStatus {
  running
  completed
  failed
}

enum PreviewStatus {
  starting
  ready
  stopped
  error
}

enum PreviewPhase {
  preparing_sandbox
  installing_dependencies
  building_project
  starting_server
  waiting_for_health_check
  preview_ready
  failed
}

enum PreviewLogLevel {
  info
  warn
  error
  stdout
  stderr
}

enum PreviewLogSource {
  system
  install
  build
  runtime
  health
}

enum PlanTier {
  free
  starter
  pro
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  trialing
}

enum AdminAuditAction {
  admin_login
  user_suspended
  user_reactivated
  user_quota_reset
  user_upgraded
  project_deleted
  project_force_rebuild
  preview_restart
  preview_stopped
  preview_deleted
  build_retried
  preview_retried
  github_sync_retried
}

enum SystemServiceStatus {
  healthy
  degraded
  down
  unknown
}

enum GithubAuditAction {
  github_connected
  github_disconnected
  repository_created
  repository_synced
  repository_sync_failed
}

enum CreditLedgerType {
  monthly_grant
  daily_grant
  consumption
  admin_adjustment
  refund
}

enum UsageEventType {
  project_created
  ai_generation
  builder_run
  preview_launch
  github_export
}

enum BillingAuditAction {
  quota_exceeded
  credits_consumed
  credits_granted
  plan_changed
}

enum UpgradeRequestStatus {
  pending
  approved
  rejected
}

enum SupportConversationStatus {
  open
  closed
}

enum SupportSenderType {
  user
  admin
}

enum SupportAuditAction {
  upgrade_requested
  upgrade_approved
  upgrade_rejected
  support_message_sent
}

enum ErrorSource {
  api
  preview
  github
  ai_provider
}

enum FeedbackCategory {
  bug
  feature
  general
  other
}

enum FeedbackStatus {
  open
  reviewed
  closed
}

enum StabilityAuditAction {
  error_logged
  feedback_submitted
  build_retried
  preview_retried
  github_sync_retried
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique
  passwordHash     String            @map("password_hash")
  name             String
  stripeCustomerId String?           @map("stripe_customer_id")
  lastLoginAt      DateTime?         @map("last_login_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  sessions         UserSession[]
  subscription     Subscription?
  projects         Project[]
  agentRuns        AgentRun[]
  githubConnection GithubConnection?
  analyticsEvents  AnalyticsEvent[]
  adminAuditLogs   AdminAuditLog[]   @relation("AdminActor")
  creditLedger     CreditLedger[]
  usageEvents      UsageEvent[]
  billingAuditLogs BillingAuditLog[]
  upgradeRequests      UpgradeRequest[]
  supportConversations SupportConversation[]
  supportAuditLogs     SupportAuditLog[]
  feedback             Feedback[]
  errorEvents          ErrorEvent[]
  stabilityAuditLogs   StabilityAuditLog[]

  @@map("users")
}

model GithubConnection {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  githubUserId         String?            @map("github_user_id")
  username             String
  encryptedAccessToken String             @map("encrypted_access_token")
  tokenType            String             @default("oauth") @map("token_type")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories         GithubRepository[]

  @@map("github_connections")
}

model GithubRepository {
  id              String           @id @default(uuid()) @db.Uuid
  projectId       String           @unique @map("project_id") @db.Uuid
  connectionId    String           @map("connection_id") @db.Uuid
  repositoryName  String           @map("repository_name")
  repositoryUrl   String           @map("repository_url")
  defaultBranch   String           @default("main") @map("default_branch")
  lastCommitSha   String?          @map("last_commit_sha")
  lastSyncedAt    DateTime?        @map("last_synced_at")
  fileSnapshot    Json?            @map("file_snapshot")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection      GithubConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("github_repositories")
}

model GithubAuditLog {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  projectId String?           @map("project_id") @db.Uuid
  action    GithubAuditAction
  message   String?
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("github_audit_logs")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  stripeSubscriptionId   String?            @map("stripe_subscription_id")
  plan                   PlanTier           @default(free)
  status                 SubscriptionStatus @default(active)
  buildsUsedThisPeriod   Int                @default(0) @map("builds_used_this_period")
  buildsLimit            Int                @default(20) @map("builds_limit")
  renewsAt               DateTime?          @map("current_period_end")
  creditsBalance         Int                @default(100) @map("credits_balance")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditLedger {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         CreditLedgerType
  amount       Int
  balanceAfter Int              @map("balance_after")
  metadata     Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

model UsageEvent {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  projectId       String?        @map("project_id") @db.Uuid
  eventType       UsageEventType @map("event_type")
  creditsConsumed Int            @default(0) @map("credits_consumed")
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType, createdAt])
  @@index([projectId, createdAt])
  @@map("usage_events")
}

model BillingAuditLog {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  action    BillingAuditAction
  message   String?
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("billing_audit_logs")
}

model UpgradeRequest {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  requestedPlan  PlanTier             @default(pro) @map("requested_plan")
  status         UpgradeRequestStatus @default(pending)
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("upgrade_requests")
}

model SupportConversation {
  id        String                    @id @default(uuid()) @db.Uuid
  userId    String                    @map("user_id") @db.Uuid
  status    SupportConversationStatus @default(open)
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]

  @@index([userId, status])
  @@index([status, updatedAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  senderType     SupportSenderType @map("sender_type")
  senderUserId   String?          @map("sender_user_id") @db.Uuid
  message        String
  readByUser     Boolean          @default(false) @map("read_by_user")
  readByAdmin    Boolean          @default(false) @map("read_by_admin")
  createdAt      DateTime         @default(now()) @map("created_at")
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("support_messages")
}

model SupportAuditLog {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  action    SupportAuditAction
  message   String?
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("support_audit_logs")
}

model ErrorLog {
  id           String      @id @default(uuid()) @db.Uuid
  fingerprint  String      @unique
  source       ErrorSource
  code         String
  message      String
  count        Int         @default(1)
  firstSeenAt  DateTime    @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime    @default(now()) @map("last_seen_at")
  events       ErrorEvent[]

  @@index([source, lastSeenAt])
  @@map("error_logs")
}

model ErrorEvent {
  id         String      @id @default(uuid()) @db.Uuid
  errorLogId String      @map("error_log_id") @db.Uuid
  source     ErrorSource
  code       String
  message    String
  userId     String?     @map("user_id") @db.Uuid
  projectId  String?     @map("project_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")
  errorLog   ErrorLog    @relation(fields: [errorLogId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([source, createdAt])
  @@index([errorLogId, createdAt])
  @@index([userId, createdAt])
  @@map("error_events")
}

model Feedback {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  category  FeedbackCategory @default(general)
  message   String
  status    FeedbackStatus   @default(open)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("feedback")
}

model StabilityAuditLog {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String?              @map("user_id") @db.Uuid
  action    StabilityAuditAction
  message   String?
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@map("stability_audit_logs")
}

model Project {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  name       String
  slug       String
  prompt     String
  status     ProjectStatus @default(draft)
  specJson   Json?         @map("spec_json")
  previewUrl           String?   @map("preview_url")
  githubRepoUrl        String?   @map("github_repo_url")
  githubRepoFullName   String?   @map("github_repo_full_name")
  githubExportedAt     DateTime? @map("github_exported_at")
  buildCount           Int       @default(0) @map("build_count")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  files      File[]
  agentRuns        AgentRun[]
  preview          Preview?
  analyticsEvents  AnalyticsEvent[]
  githubRepository GithubRepository?

  @@unique([userId, slug])
  @@index([userId])
  @@map("projects")
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  role      MessageRole
  content   String
  createdAt DateTime    @default(now()) @map("created_at")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("messages")
}

model File {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  path      String
  content   String
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId, path])
  @@map("files")
}

model AgentRun {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  agentType     AgentType      @map("agent_type")
  status        AgentRunStatus @default(running)
  inputPrompt   String         @map("input_prompt")
  outputSummary String?        @map("output_summary")
  tokensInput      Int            @default(0) @map("tokens_input")
  tokensOutput     Int            @default(0) @map("tokens_output")
  toolCalls        Int?           @map("tool_calls")
  filesGenerated   Int?           @map("files_generated")
  buildDurationMs  Int?           @map("build_duration_ms")
  errorCode        String?        @map("error_code")
  failurePhase     String?        @map("failure_phase")
  retryCount       Int?           @map("retry_count")
  errorMessage       String?        @map("error_message")
  llmProvider        String?        @map("llm_provider")
  estimatedCostUsd   Float?         @map("estimated_cost_usd")
  startedAt          DateTime       @default(now()) @map("started_at")
  completedAt        DateTime?      @map("completed_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([agentType, status])
  @@map("agent_runs")
}

model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String   @map("event_type")
  userId    String?  @map("user_id") @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@map("analytics_events")
}

model Preview {
  id               String        @id @default(uuid()) @db.Uuid
  projectId        String        @unique @map("project_id") @db.Uuid
  sandboxId        String?       @map("sandbox_id")
  url              String?
  status           PreviewStatus @default(starting)
  phase            PreviewPhase  @default(preparing_sandbox)
  detectedPort     Int?          @map("detected_port")
  framework        String?
  packageManager   String?       @map("package_manager")
  errorCode        String?       @map("error_code")
  errorMessage     String?       @map("error_message")
  expiresAt        DateTime?     @map("expires_at")
  startedAt        DateTime?     @map("started_at")
  estimatedCostUsd Float?        @map("estimated_cost_usd")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs             PreviewLog[]

  @@index([status, expiresAt])
  @@map("previews")
}

model PreviewLog {
  id        String           @id @default(uuid()) @db.Uuid
  previewId String           @map("preview_id") @db.Uuid
  level     PreviewLogLevel  @default(info)
  source    PreviewLogSource @default(system)
  message   String
  createdAt DateTime         @default(now()) @map("created_at")
  preview   Preview          @relation(fields: [previewId], references: [id], onDelete: Cascade)

  @@index([previewId, createdAt])
  @@map("preview_logs")
}

model AdminAuditLog {
  id          String           @id @default(uuid()) @db.Uuid
  adminUserId String           @map("admin_user_id") @db.Uuid
  action      AdminAuditAction
  targetType  String?          @map("target_type")
  targetId    String?          @map("target_id")
  targetLabel String?          @map("target_label")
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  admin       User             @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([action, createdAt])
  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}

model SystemMetric {
  id         String              @id @default(uuid()) @db.Uuid
  service    String
  status     SystemServiceStatus @default(unknown)
  latencyMs  Int?                @map("latency_ms")
  details    Json?
  checkedAt  DateTime            @default(now()) @map("checked_at")

  @@index([service, checkedAt])
  @@map("system_metrics")
}

model UsageMetric {
  id               String   @id @default(uuid()) @db.Uuid
  date             DateTime @db.Date
  provider         String
  requestCount     Int      @default(0) @map("request_count")
  failedCount      Int      @default(0) @map("failed_count")
  tokensInput      Int      @default(0) @map("tokens_input")
  tokensOutput     Int      @default(0) @map("tokens_output")
  estimatedCostUsd Float    @default(0) @map("estimated_cost_usd")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([date, provider])
  @@index([date])
  @@map("usage_metrics")
}
