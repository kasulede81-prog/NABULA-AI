{
  "name": "nebula-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI Software Engineer platform — describe software in plain English, get complete applications",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "postinstall": "pnpm db:generate",
    "db:generate": "pnpm --filter @nebula/database generate",
    "db:migrate:dev": "pnpm --filter @nebula/database migrate",
    "db:migrate:deploy": "pnpm --filter @nebula/database migrate:deploy",
    "verify:sse": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-sse-hijack.ts",
    "verify:phase1": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-phase1.ts",
    "verify:e2e": "pnpm --filter @nebula/api exec tsx ../../scripts/e2e-verify.ts",
    "verify:path-security": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-path-security.ts",
    "verify:retry": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-retry-classification.ts",
    "verify:clarifier-lock": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-clarifier-lock.ts",
    "verify:normalize-write-files": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-normalize-write-files.ts",
    "verify:write-files-parser": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-write-files-parser.ts",
    "verify:encoding-sanitize": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-encoding-sanitize.ts",
    "verify:llm-provider": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-llm-provider.ts",
    "verify:deepseek-tool-compliance": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-deepseek-tool-compliance.ts",
    "verify:preview-mvp": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-preview-mvp.ts",
    "verify:preview-template": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-preview-template.ts",
    "build:e2b-preview-template": "pnpm --filter @nebula/api exec tsx ../../infrastructure/e2b/build-template.ts",
    "verify:github-export": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-github-export.ts",
    "verify:build-analytics": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-build-analytics.ts",
    "verify:monaco-editor": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-monaco-editor.ts",
    "verify:production-foundation": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-production-foundation.ts",
    "verify:supabase-tables": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-supabase-tables.ts",
    "e2e:mvp": "pnpm --filter @nebula/api exec tsx ../../scripts/e2e-mvp-verification.ts",
    "benchmark:deepseek-crm": "pnpm --filter @nebula/api exec tsx ../../scripts/benchmark-deepseek-crm.ts",
    "verify:phase2-fixes": "pnpm verify:path-security && pnpm verify:retry && pnpm verify:clarifier-lock && pnpm verify:normalize-write-files && pnpm verify:write-files-parser && pnpm verify:encoding-sanitize",
    "validate:phase2-reliability": "pnpm --filter @nebula/api exec tsx ../../scripts/validate-phase2-reliability.ts",
    "validate:phase2-optimization": "pnpm --filter @nebula/api exec tsx ../../scripts/validate-phase2-optimization.ts",
    "verify:build-validation": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-build-validation.ts",
    "verify:build-manifest": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-build-manifest.ts",
    "verify:ready-first": "pnpm verify:build-manifest && pnpm verify:build-validation && pnpm verify:ready-first-architecture",
    "verify:ready-first-architecture": "pnpm --filter @nebula/api exec tsx ../../scripts/verify-ready-first-architecture.ts",
    "postgres:embedded": "pnpm --filter @nebula/api exec tsx ../../scripts/start-embedded-postgres.ts",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down"
  },
  "devDependencies": {
    "embedded-postgres": "16.13.0-beta.17",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
